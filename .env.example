# Required. A fine-grained GitHub token with "Public repositories (read-only)" access and no
# extra permissions: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional settings (defaults shown)
# PORT=8080
# HOST=127.0.0.1
# LOG_LEVEL=info
# DATABASE_PATH=data/flowsight.db
# Restrict which repositories can be analysed (comma-separated owner/name). Unset = any public repo.
# ALLOWED_REPOS=withastro/astro,vitejs/vite,astral-sh/ruff

# AI insights (GET .../insights). Any OpenAI-compatible API works; the default is Google Gemini's
# free tier — create a key at https://aistudio.google.com/apikey (no credit card).
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is rate limited or out of quota (each has its own quota).
# LLM_BACKUP_MODELS=gemini-3.5-flash
# Fully local alternative with Ollama: LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama LLM_MODEL=qwen3:8b LLM_BACKUP_MODELS=qwen3:8b
